# Copy this file to backend/.env and restart the backend after editing.
# Existing shell/hosting environment variables take precedence over .env.
CACHE_TTL_SECONDS=3600
# CACHE_PATH defaults to backend/.cache/elexon.sqlite3
# Comma-separated frontend origins: scheme + hostname + optional port.
# No paths or trailing slashes. Add your deployed frontend origin here.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
